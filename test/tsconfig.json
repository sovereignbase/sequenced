{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": "..",
    "types": ["node"]
  },
  "include": [
    "compability/*.ts",
    "convergence/*.ts",
    "equivelance/*.ts",
    "events/*.ts",
    "integration/*.ts",
    "unit/*.ts",
    ".shared/**/*.ts",
    "../benchmark/**/*.ts",
    "../scripts/**/*.ts",
    "../playwright.config.ts",
    "../vitest.config.ts"
  ]
}
