{
  "type": "module",
  "license": "Apache-2.0",
  "name": "@sovereignbase/sequenced",
  "version": "0.0.0",
  "description": "",
  "keywords": [
    "typescript",
    "sovereignbase"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier . --write",
    "build": "npm run build:package && npm run build:docs",
    "build:package": "tsdown",
    "build:docs": "typedoc",
    "test": "npm run build:package && npm run typecheck && npm run test:vitest && npm run test:e2e",
    "typecheck": "tsc --noEmit --project test/tsconfig.json",
    "test:vitest": "vitest run --coverage",
    "test:array": "vitest run test/array --coverage.enabled=false",
    "test:array:watch": "vitest test/array --coverage.enabled=false",
    "typecheck:array": "tsc --project test/array/tsconfig.json",
    "test:e2e": "playwright test",
    "bench": "vitest run --config benchmark/vitest.config.ts",
    "bench:array": "vitest run --config benchmark/vitest.config.ts benchmark/array",
    "prepare": "husky",
    "prepublishOnly": "npm run test && npm run bench",
    "test:text": "vitest run test/text --coverage.enabled=false",
    "test:text:watch": "vitest test/text --coverage.enabled=false",
    "typecheck:text": "tsc --project test/text/tsconfig.json",
    "bench:text": "vitest run --config benchmark/vitest.config.ts benchmark/text",
    "test:map": "vitest run test/map --coverage.enabled=false",
    "test:map:watch": "vitest test/map --coverage.enabled=false",
    "typecheck:map": "tsc --project test/map/tsconfig.json",
    "bench:map": "vitest run --config benchmark/vitest.config.ts benchmark/map"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/sequenced.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/sequenced/issues"
  },
  "homepage": "https://sovereignbase.dev/sequenced",
  "dependencies": {
    "@sovereignbase/sequencer": "1.0.2"
  }
}
