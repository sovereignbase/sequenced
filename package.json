{
  "type": "module",
  "license": "Apache-2.0",
  "name": "@sovereignbase/sequenced",
  "version": "0.0.0",
  "description": "Replicated Array, Map and Text implementations built on Sequencer",
  "keywords": [
    "crdt",
    "collaborative-editing"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier . --write",
    "reports": "node scripts/reporting.ts",
    "build": "npm run build:package && npm run build:docs",
    "build:package": "tsdown",
    "build:docs": "typedoc",
    "test": "npm run build:package && npm run typecheck && npm run test:vitest && npm run test:e2e",
    "typecheck": "tsc --noEmit --project test/tsconfig.json",
    "test:vitest": "vitest run --coverage",
    "test:array": "vitest run array --coverage.enabled=false",
    "test:array:watch": "vitest array --coverage.enabled=false",
    "typecheck:array": "tsc --project test/tsconfig.array.json",
    "test:e2e": "playwright test",
    "bench": "vitest run --config benchmark/vitest.config.ts",
    "bench:array": "vitest run --config benchmark/vitest.config.ts benchmark/array",
    "prepare": "husky",
    "prepublishOnly": "npm run test && npm run bench",
    "test:text": "vitest run text --coverage.enabled=false",
    "test:text:watch": "vitest text --coverage.enabled=false",
    "typecheck:text": "tsc --project test/tsconfig.text.json",
    "bench:text": "vitest run --config benchmark/vitest.config.ts benchmark/text",
    "test:map": "vitest run map --coverage.enabled=false",
    "test:map:watch": "vitest map --coverage.enabled=false",
    "typecheck:map": "tsc --project test/tsconfig.map.json",
    "bench:map": "vitest run --config benchmark/vitest.config.ts benchmark/map",
    "test:compability": "npm run build:package && vitest run test/compability --coverage.enabled=false --passWithNoTests && playwright test test/compability",
    "test:convergence": "vitest run test/convergence --coverage.enabled=false",
    "test:equivelance": "vitest run test/equivelance --coverage.enabled=false",
    "test:events": "vitest run test/events --coverage.enabled=false",
    "test:integration": "npm run build:package && vitest run test/integration --coverage.enabled=false --passWithNoTests && playwright test test/integration",
    "test:unit": "vitest run test/unit --coverage.enabled=false"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "bun": "^1.4.3",
    "deno": "^2.9.6",
    "edge-runtime": "^4.0.1",
    "husky": "^9.1.7",
    "miniflare": "^5.20261006.2-beta",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/sequenced.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/sequenced/issues"
  },
  "homepage": "https://sovereignbase.dev/sequenced",
  "dependencies": {
    "@sovereignbase/bytecodec": "^2.0.1",
    "@sovereignbase/sequencer": "1.0.2"
  }
}
